# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# API key for the AI model CafeBot will use
OPENAI_API_KEY=

# Port the backend server will run on
PORT=3000

# Sales tax rate applied to the discounted subtotal, as a decimal (e.g. 0.08 = 8%)
TAX_RATE=0

# Flat delivery fee applied to delivery orders (in dollars)
DELIVERY_FEE=0
